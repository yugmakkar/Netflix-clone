# TMDB (The Movie Database) API key — free, get one at:
# https://www.themoviedb.org/settings/api  (use the "API Read Access Token (v3 auth)" API Key, v3)
#
# Copy this file to `.env` and paste your key below.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
#
# The app still runs WITHOUT a key (it falls back to bundled sample data),
# but live catalog, search and trailers need one.
VITE_TMDB_API_KEY=
